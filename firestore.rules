rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Members and admins are anyone with a real (non-anonymous) account —
    // i.e. anyone the createMember Cloud Function has stamped with a role.
    function isMember() {
      return isSignedIn() && request.auth.token.role in ['member', 'admin'];
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    // Item catalog: guests need to read it to know what they can order.
    // Members can add items, edit categories/recipes, and adjust quantities,
    // but only admins can set or change buyPrice/sellPrice.
    function pricesUnchanged() {
      return request.resource.data.buyPrice == resource.data.buyPrice
          && request.resource.data.sellPrice == resource.data.sellPrice;
    }
    function noPricesSet() {
      return request.resource.data.buyPrice == null
          && request.resource.data.sellPrice == null;
    }
    match /items/{itemId} {
      allow read: if isSignedIn();
      allow create: if isMember() && (isAdmin() || noPricesSet());
      allow update: if isMember() && (isAdmin() || pricesUnchanged());
      allow delete: if isMember();
    }

    // Orders: anyone signed in (guest or member) can place one, and anyone
    // signed in can view the queue. Managing an order (marking it fulfilled,
    // cancelling, deleting) is member/admin only.
    match /orders/{orderId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update, delete: if isMember();
    }

    // Account directory: only written by the createMember Cloud Function
    // (Admin SDK bypasses these rules entirely). Admins can list everyone;
    // a person can read their own profile.
    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow write: if false;
    }

    // Default deny for anything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
